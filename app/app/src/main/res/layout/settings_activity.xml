<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<!--     Title-->

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:text="Settings:" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/title"
        android:background="?android:attr/listDivider" />

<!--    Username    -->

    <TextView
        android:id="@+id/uname_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@id/divider"
        android:text="Username (UNAME in .env):" />

    <EditText
        android:id="@+id/uname_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@id/uname_title"
        android:hint="Example Username..." />

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/uname_input"
        android:background="?android:attr/listDivider" />


<!--        Password     -->

    <TextView
        android:id="@+id/password_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@id/divider2"
        android:text="Password (PASSWORD in .env)" />

    <EditText
        android:id="@+id/password_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@id/password_title"
        android:hint="My Password..." />

    <View
        android:id="@+id/divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/password_input"
        android:background="?android:attr/listDivider" />


    <TextView
        android:id="@+id/serve_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@id/divider3"
        android:text="Server URL: " />

    <EditText
        android:id="@+id/serve_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/serve_title"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:hint="http://example.ddns.net/api..." />


    <View
        android:id="@+id/divider4"
        android:layout_width="match_parent"
        android:layout_below="@id/serve_input"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!--    Test Username and Password    -->

    <Button
        android:id="@+id/test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider4"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp"
        android:text="Test Connection" />

    <Button
        android:id="@+id/save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider4"
        android:layout_alignParentEnd="true"
        android:layout_margin="10dp"
        android:layout_toEndOf="@+id/test"
        android:text="Save" />

    <View
        android:id="@+id/divider5"
        android:layout_width="match_parent"
        android:layout_below="@id/serve_input"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:id="@+id/codeResp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@+id/save"
        android:text="" />

    <TextView
        android:id="@+id/conn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_margin="10dp"
        android:layout_below="@+id/codeResp"
        android:text=""/>



</RelativeLayout>